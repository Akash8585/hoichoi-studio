# Neon Postgres pooled connection (hostname includes -pooler); require SSL
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-long-random-string-at-least-32-chars"
# Google OAuth (Cloud Console). Authorized redirect URI:
# {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OPENROUTER_API_KEY=""
OPENROUTER_TEXT_MODEL="qwen/qwen3.8-27b:free"

# Cloudflare AI Gateway + Workers AI
# Token permissions: AI Gateway Run + Workers AI Read
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_AI_GATEWAY_ID="default"
CLOUDFLARE_UNIFIED_BILLING="false"
CLOUDFLARE_TEXT_MODEL="google/gemini-3-flash"
CLOUDFLARE_WORKERS_TEXT_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"
CLOUDFLARE_IMAGE_MODEL="@cf/bytedance/stable-diffusion-xl-lightning"
CLOUDFLARE_VIDEO_MODEL="google/veo-3.1-fast"

# Pollinations Gen API — optional image fallback. Video stays unused in the MVP.
# Create a secret key (sk_...) at https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=""
POLLINATIONS_IMAGE_MODEL="flux"
POLLINATIONS_VIDEO_MODEL="bytedance/seedance-1-pro-fast"
IMAGE_PROVIDER="cloudflare_primary"
# Video Studio is deferred. Do not set a provider that queues generation in this MVP.
VIDEO_PROVIDER="deferred"

DEMO_USER_EMAIL="editor@hoichoi.demo"
DEMO_USER_PASSWORD="HoichoiDemo2026!"
CRON_SECRET="replace-cron-secret"
SEED_DEMO_ON_BOOT="true"

# Cloudflare R2 (required on Vercel; local falls back to public/generated/)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="hoichoi-media"
# R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"
